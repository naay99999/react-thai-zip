{
  "name": "react-thaizip",
  "version": "0.3.7",
  "description": "CLI scaffold tool for adding thaizip React address autocomplete components.",
  "type": "module",
  "bin": {
    "react-thaizip": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "!templates/**/__fixtures__/**"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:templates": "tsc -p tsconfig.templates.json && tsc -p tsconfig.templates.base.json && tsc -p tsconfig.templates.radix.json && tsc -p tsconfig.templates.aria.json",
    "sandbox": "node scripts/sandbox.mjs"
  },
  "keywords": [
    "thai",
    "address",
    "autocomplete",
    "react",
    "nextjs",
    "thaizip"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naay99999/react-thai-zip.git"
  },
  "homepage": "https://react-thai-zip.vercel.app",
  "author": "narablyat",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "prompts": "^2.4.2",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.10.5",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.5",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.40.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "shadcn": "^4.20.1",
    "tailwind-merge": "^3.6.0",
    "thaizip": "^0.7.5",
    "tsup": "^8.3.5",
    "vitest": "^2.1.8"
  }
}
