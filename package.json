{
  "name": "react-thaizip",
  "version": "0.3.3",
  "description": "CLI scaffold tool for adding thaizip React address autocomplete components.",
  "type": "module",
  "bin": {
    "react-thaizip": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:templates": "tsc -p tsconfig.templates.json",
    "sandbox": "node scripts/sandbox.mjs"
  },
  "keywords": [
    "thai",
    "address",
    "autocomplete",
    "react",
    "nextjs",
    "thaizip"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naay99999/react-thai-zip.git"
  },
  "author": "narablyat",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "execa": "^9.6.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.10.5",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "clsx": "^2.1.1",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "thaizip": "^0.7.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
