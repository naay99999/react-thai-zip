{
  "name": "react-thaizip",
  "version": "0.4.1",
  "description": "CLI scaffold tool for adding thaizip React address autocomplete components.",
  "type": "module",
  "bin": {
    "react-thaizip": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "!templates/**/__fixtures__/**"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:templates": "tsc -p tsconfig.templates.json && tsc -p tsconfig.templates.base.json && tsc -p tsconfig.templates.radix.json && tsc -p tsconfig.templates.aria.json",
    "sandbox": "node scripts/sandbox.mjs",
    "generate-registry": "node scripts/generate-registry.mjs"
  },
  "keywords": [
    "thai",
    "address",
    "autocomplete",
    "react",
    "nextjs",
    "thaizip"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naay99999/react-thai-zip.git"
  },
  "homepage": "https://thai-zip.vercel.app/docs/react",
  "author": "narablyat",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "prompts": "^2.4.2",
    "sucrase": "3.35.1"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.6.5",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "jsdom": "^30.1.2",
    "lucide-react": "^1.55.0",
    "radix-ui": "^1.8.0",
    "react": "^19.3.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "tailwind-merge": "^3.7.0",
    "thaizip": "^0.7.6",
    "tsup": "^9.0.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
