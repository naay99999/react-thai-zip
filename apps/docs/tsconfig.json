{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/components/thai-address-autocomplete": ["./components/style-switch/autocomplete"],
      "@/components/thai-address-cascade-select": ["./components/style-switch/cascade-select"],
      "@/components/thai-address-form": ["./components/style-switch/form"],
      "@/components/thai-address-form-field": ["./components/style-switch/form-field"],
      "@/components/*": [
        "../../templates/react/ts/*"
      ],
      "@/*": [
        "../../templates/react/ts/*"
      ],
      "~/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
