{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@/lib/utils": ["./templates/react/ts/lib/utils.ts"],
      "@/hooks/use-thai-address-index": ["./templates/react/ts/hooks/use-thai-address-index.ts"],
      "@/hooks/use-thai-address-cascade": ["./templates/react/ts/hooks/use-thai-address-cascade.ts"]
    }
  },
  "include": [
    "templates/react/ts/*.tsx",
    "templates/react/ts/lib/**/*.ts",
    "templates/react/ts/hooks/**/*.ts",
    "tests/thai-address-autocomplete.test.tsx",
    "tests/thai-address-autocomplete-loading.test.tsx",
    "tests/thai-address-cascade-select.test.tsx",
    "tests/thai-address-display.test.tsx",
    "tests/thai-address-form.test.tsx",
    "tests/thai-address-form-field.test.tsx",
    "tests/use-thai-address-cascade.test.tsx"
  ]
